    const $ = (id) => document.getElementById(id);
    const setup = $('setup');
    const quiz = $('quiz');
    const summary = $('summary');
    let selectedSubject = 'history';
    let selectedLevel = 'level1';
    let currentRoundQuestions = [];
    let questionIndex = 0;
    let roundNumber = 1;
    let questionResults = [];
    let answered = false;
    let testMode = 'practice';
    let timerInterval = null;
    let remainingSeconds = 0;
    let startedAt = 0;
    let timeLimitSeconds = 0;
    let isFinishing = false;

    const letters = ['A', 'B', 'C', 'D', 'E', 'F'];

    function shuffleArray(array) {
      const copy = [...array];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    function prepareQuestion(originalQuestion) {
      const pairedOptions = originalQuestion.options.map((text, index) => ({
        text,
        isCorrect: index === originalQuestion.answer
      }));
      const shuffledOptions = shuffleArray(pairedOptions);
      return {
        original: originalQuestion,
        question: originalQuestion.question,
        explanation: originalQuestion.explanation || '',
        options: shuffledOptions.map(option => option.text),
        answer: shuffledOptions.findIndex(option => option.isCorrect)
      };
    }

    function stopTimer() {
      if (timerInterval !== null) {
        clearInterval(timerInterval);
        timerInterval = null;
      }
    }

    function formatTime(seconds) {
      const safeSeconds = Math.max(0, Math.floor(seconds));
      const minutes = Math.floor(safeSeconds / 60);
      const secs = safeSeconds % 60;
      return `${String(minutes).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }

    function updateTimerDisplay() {
      $('timerLabel').textContent = formatTime(remainingSeconds);
      $('timerBox').classList.toggle('warning', remainingSeconds <= 60);
    }

    function startTimer() {
      stopTimer();
      if (testMode !== 'timed') {
        $('timerBox').classList.add('hidden');
        return;
      }
      $('timerBox').classList.remove('hidden');
      updateTimerDisplay();
      timerInterval = setInterval(() => {
        remainingSeconds = Math.max(0, remainingSeconds - 1);
        updateTimerDisplay();
        if (remainingSeconds <= 0) {
          stopTimer();
          finishRound(true);
        }
      }, 1000);
    }

    function startTest() {
      selectedSubject = $('subjectSelect').value;
      selectedLevel = $('levelSelect').value;
      testMode = $('modeSelect').value;
      const sourceQuestions = questionLibrary[selectedSubject]?.[selectedLevel] || [];
      if (!sourceQuestions.length) {
        $('setupMessage').textContent = 'Бұл пән мен деңгейге сұрақ әлі қосылмаған. Қажет болса, questionLibrary бөліміндегі бос массивке сұрақ қос.';
        return;
      }
      roundNumber = 1;
      timeLimitSeconds = Number($('timeLimitSelect').value) * 60;
      remainingSeconds = timeLimitSeconds;
      startedAt = Date.now();
      isFinishing = false;
      beginRound(sourceQuestions, true);
    }

    function beginRound(questions, resetTimer = false) {
      stopTimer();
      currentRoundQuestions = shuffleArray(questions).map(prepareQuestion);
      questionResults = currentRoundQuestions.map(() => ({ status: 'unanswered', chosenIndex: null }));
      questionIndex = 0;
      answered = false;
      isFinishing = false;
      setup.classList.add('hidden');
      summary.classList.add('hidden');
      quiz.classList.remove('hidden');
      if (resetTimer && testMode === 'timed') {
        remainingSeconds = timeLimitSeconds;
        startedAt = Date.now();
      }
      buildQuestionNav();
      renderQuestion();
      startTimer();
    }

    function buildQuestionNav() {
      const nav = $('questionNav');
      nav.replaceChildren();
      currentRoundQuestions.forEach((_, index) => {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'question-chip';
        chip.textContent = String(index + 1);
        chip.setAttribute('aria-label', `${index + 1}-сұраққа өту`);
        chip.addEventListener('click', () => goToQuestion(index));
        nav.appendChild(chip);
      });
      updateQuestionNav();
    }

    function updateQuestionNav() {
      const chips = [...$('questionNav').querySelectorAll('.question-chip')];
      chips.forEach((chip, index) => {
        const status = questionResults[index]?.status || 'unanswered';
        chip.classList.toggle('current', index === questionIndex);
        chip.classList.toggle('correct', status === 'correct');
        chip.classList.toggle('wrong', status === 'wrong');
        chip.classList.toggle('skipped', status === 'skipped');
        chip.setAttribute('aria-current', index === questionIndex ? 'step' : 'false');
      });
    }

    function renderQuestion() {
      if (!currentRoundQuestions.length || questionIndex < 0 || questionIndex >= currentRoundQuestions.length) return;
      const item = currentRoundQuestions[questionIndex];
      const result = questionResults[questionIndex];
      answered = result.status === 'correct' || result.status === 'wrong';
      $('roundLabel').textContent = `${roundNumber}-раунд`;
      $('progressLabel').textContent = `${questionIndex + 1} / ${currentRoundQuestions.length} сұрақ`;
      const resolvedCount = questionResults.filter(r => r.status === 'correct' || r.status === 'wrong').length;
      $('progressBar').style.width = `${(resolvedCount / currentRoundQuestions.length) * 100}%`;
      $('questionNumber').textContent = `${questionIndex + 1}-СҰРАҚ`;
      $('questionText').textContent = item.question;
      $('optionsContainer').replaceChildren();
      $('feedback').className = 'feedback hidden';
      $('feedback').replaceChildren();
      $('scoreMini').textContent = `Дұрыс: ${countStatus('correct')} · Қате: ${countStatus('wrong')} · Өткізілген: ${countStatus('skipped')}`;
      $('previousQuestionButton').disabled = questionIndex === 0;
      $('skipButton').classList.toggle('hidden', result.status === 'correct' || result.status === 'wrong');
      $('skipButton').textContent = result.status === 'skipped' ? 'Өткізілді' : 'Өткізіп жіберу ↷';
      $('skipButton').disabled = result.status === 'skipped';
      $('nextButton').textContent = questionIndex === currentRoundQuestions.length - 1 ? 'Раунд қорытындысы →' : 'Келесі сұрақ →';

      item.options.forEach((optionText, index) => {
        const button = document.createElement('button');
        button.className = 'option';
        button.type = 'button';
        const letter = document.createElement('span');
        letter.className = 'letter';
        letter.textContent = letters[index] || String(index + 1);
        const text = document.createElement('span');
        text.textContent = optionText;
        button.append(letter, text);
        if (result.status === 'correct' || result.status === 'wrong') {
          button.disabled = true;
          if (index === item.answer) button.classList.add('correct');
          if (index === result.chosenIndex && result.status === 'wrong') button.classList.add('wrong');
        } else if (result.status === 'skipped' && testMode === 'timed' && remainingSeconds <= 0) {
          button.disabled = true;
        } else {
          button.addEventListener('click', () => checkAnswer(index));
        }
        $('optionsContainer').appendChild(button);
      });

      if (result.status === 'correct' || result.status === 'wrong') {
        showFeedback(result.status === 'correct', item.explanation);
      } else if (result.status === 'skipped') {
        showFeedback(false, 'Бұл сұрақ өткізіліп жіберілді. Дұрыс жауабын таңдап, сұрақты әлі де бекіте аласың.');
      }
      $('nextButton').classList.remove('hidden');
      updateQuestionNav();
    }

    function countStatus(status) {
      return questionResults.filter(result => result.status === status).length;
    }

    function showFeedback(isCorrect, explanation, customTitle = '') {
      const feedback = $('feedback');
      feedback.className = `feedback ${isCorrect ? 'good' : 'bad'}`;
      feedback.replaceChildren();
      const title = document.createElement('strong');
      title.textContent = customTitle || (isCorrect ? 'Дұрыс жауап!' : 'Қате жауап. Бұл сұрақ келесі раундта қайталанады.');
      feedback.appendChild(title);
      if (explanation) {
        const detail = document.createElement('div');
        detail.textContent = explanation;
        feedback.appendChild(detail);
      }
    }

    function checkAnswer(chosenIndex) {
      const item = currentRoundQuestions[questionIndex];
      const result = questionResults[questionIndex];
      if (!item || result.status === 'correct' || result.status === 'wrong') return;
      result.chosenIndex = chosenIndex;
      result.status = chosenIndex === item.answer ? 'correct' : 'wrong';
      answered = true;
      renderQuestion();
    }

    function goToQuestion(index) {
      if (index < 0 || index >= currentRoundQuestions.length || index === questionIndex) return;
      questionIndex = index;
      renderQuestion();
      const currentChip = $('questionNav').querySelector('.question-chip.current');
      currentChip?.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
    }

    function previousQuestion() {
      if (questionIndex > 0) goToQuestion(questionIndex - 1);
    }

    function skipQuestion() {
      const result = questionResults[questionIndex];
      if (result.status === 'correct' || result.status === 'wrong' || result.status === 'skipped') return;
      result.status = 'skipped';
      result.chosenIndex = null;
      updateQuestionNav();
      if (questionIndex < currentRoundQuestions.length - 1) {
        questionIndex++;
        renderQuestion();
      } else {
        showSummary();
      }
    }

    function nextQuestion() {
      const currentResult = questionResults[questionIndex];
      if (currentResult.status === 'unanswered') {
        currentResult.status = 'skipped';
        updateQuestionNav();
      }
      if (questionIndex < currentRoundQuestions.length - 1) {
        questionIndex++;
        renderQuestion();
      } else {
        showSummary();
      }
    }

    function finishRound(timeExpired = false) {
      if (isFinishing) return;
      isFinishing = true;
      if (timeExpired) {
        // Уақыт біткенде жауап берілмеген сұрақтар өткізіліп, келесі раундқа сақталады.
        questionResults.forEach(result => {
          if (result.status === 'unanswered') result.status = 'skipped';
        });
      }
      showSummary(timeExpired);
    }

    function showSummary(timeExpired = false) {
      stopTimer();
      quiz.classList.add('hidden');
      summary.classList.remove('hidden');
      const total = currentRoundQuestions.length;
      const correct = countStatus('correct');
      const missed = questionResults.filter(r => r.status !== 'correct');
      const wrong = total - correct;
      const accuracy = total ? Math.round((correct / total) * 100) : 0;
      $('statCorrect').textContent = correct;
      $('statWrong').textContent = wrong;
      $('statAccuracy').textContent = `${accuracy}%`;
      const hasMissed = missed.length > 0;
      $('summaryIcon').textContent = hasMissed ? '↻' : '✦';
      $('summaryTitle').textContent = timeExpired ? 'Уақыт аяқталды' : (hasMissed ? 'Қателерді қайталап бекітейік!' : 'Тамаша! Барлық сұрақ дұрыс!');
      const skippedCount = questionResults.filter(r => r.status === 'skipped' || r.status === 'unanswered').length;
      let note = hasMissed
        ? `Бұл раундта ${correct} сұраққа дұрыс жауап бердің. ${missed.length} сұрақ келесі раундта қайта беріледі. Жауап нұсқалары қайта араластырылады.`
        : `Сен осы раундтағы ${total} сұрақтың бәріне дұрыс жауап бердің. Дайындықты басқа деңгейдегі немесе басқа пәндегі сұрақтармен жалғастыра аласың.`;
      if (skippedCount) note += ` Жауап берілмеген немесе өткізіліп кеткен сұрақтар: ${skippedCount}.`;
      if (testMode === 'timed') {
        const elapsed = Math.max(0, Math.round((Date.now() - startedAt) / 1000));
        note += timeExpired ? ' Тест белгіленген уақыт аяқталғандықтан тоқтатылды.' : ` Жұмсалған уақыт: ${formatTime(elapsed)}.`;
      }
      $('summaryNote').textContent = note;
      $('retryButton').classList.toggle('hidden', !hasMissed);
      $('homeButton').textContent = hasMissed ? 'Басты бетке оралу' : 'Басқа тест таңдау';
    }

    function retryMissed() {
      const toRepeat = currentRoundQuestions.filter((_, index) => questionResults[index].status !== 'correct').map(item => item.original);
      if (!toRepeat.length) return;
      roundNumber++;
      if (testMode === 'timed') {
        remainingSeconds = timeLimitSeconds;
        startedAt = Date.now();
      }
      beginRound(toRepeat, testMode === 'timed');
    }

    function goHome() {
      stopTimer();
      quiz.classList.add('hidden');
      summary.classList.add('hidden');
      setup.classList.remove('hidden');
      $('setupMessage').textContent = '';
      $('timerBox').classList.add('hidden');
    }

    $('startButton').addEventListener('click', startTest);
    $('nextButton').addEventListener('click', nextQuestion);
    $('skipButton').addEventListener('click', skipQuestion);
    $('previousQuestionButton').addEventListener('click', previousQuestion);
    $('backToSetupButton').addEventListener('click', () => {
      if (window.confirm('Тесттен шығып, басты бетке қайтқың келе ме?')) goHome();
    });
    $('retryButton').addEventListener('click', retryMissed);
    $('homeButton').addEventListener('click', goHome);
    $('modeSelect').addEventListener('change', () => {
      $('timeLimitField').classList.toggle('hidden', $('modeSelect').value !== 'timed');
    });
    $('subjectSelect').addEventListener('change', updateSetupMessage);
    $('levelSelect').addEventListener('change', updateSetupMessage);

    function updateSetupMessage() {
      const subject = $('subjectSelect').value;
      const level = $('levelSelect').value;
      const count = questionLibrary[subject]?.[level]?.length || 0;
      $('setupMessage').textContent = count ? `Осы таңдауда ${count} сұрақ бар.` : 'Бұл бөлімге сұрақтар әлі қосылмаған.';
    }

    updateSetupMessage();
  </script>
</body>
</html>
